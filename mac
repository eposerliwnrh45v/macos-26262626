name: Browser Mac
on: workflow_dispatch

jobs:
  mac:
    runs-on: macos-latest
    steps:
      - name: Start Mac
        run: |
          sudo /System/Library/CoreServices/RemoteManagement/ARDAgent.app/Contents/Resources/kickstart -activate -configure -access -on -clientopts -setvnclegacy -vnclegacy yes -clientopts -setvncpw -vncpw password123 -restart -agent -privs -all
          brew install cloudflared
          pip3 install --break-system-packages websockify
          git clone https://github.com
          ./noVNC/utils/novnc_proxy --vnc localhost:5900 --listen 6080 &
          sleep 3
          cloudflared tunnel --url http://localhost:6080 > tunnel.log 2>&1 &
          sleep 10
          grep -o 'https://[-0-9a-z]*\.trycloudflare\.com' tunnel.log | head -n 1
          sleep 19800
